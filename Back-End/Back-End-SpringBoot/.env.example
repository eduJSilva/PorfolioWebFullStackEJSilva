# Copiar a .env (no se commitea) o configurar como variables de entorno en el hosting.
PORT=8080

# MySQL
DB_URL=jdbc:mysql://HOST:3306/BASE?useSSL=true&serverTimezone=UTC
DB_USERNAME=usuario
DB_PASSWORD=contraseña
JPA_DDL_AUTO=update

# JWT: usar un valor largo y aleatorio (p. ej. `openssl rand -base64 64`)
APP_JWT_SECRET=
APP_JWT_EXPIRATION=3600000

# Front-end
APP_FRONTEND_URL=https://silvaeduardojavierporfolio.vercel.app
APP_CORS_ALLOWED_ORIGINS=https://silvaeduardojavierporfolio.vercel.app,https://porfolioeduardojsilva.web.app,http://localhost:4200

# Opcional: email de un usuario existente que debe tener rol ADMIN (se aplica al arrancar)
APP_ADMIN_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (Gmail: usar una "contraseña de aplicación")
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
